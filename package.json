{
  "name": "repo",
  "packageManager": "npm@11.7.0",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev dev:worker",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
