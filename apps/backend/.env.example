PORT=3000
HOST=0.0.0.0

DATABASE_URL="postgresql://movies:movies@localhost:5432/movies_db?schema=public"

ACCESS_TOKEN_SECRET="your-secret-key-here"

RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="noreply@example.com"

# Token expiration settings (optional - defaults shown)
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"
PASSWORD_RESET_TOKEN_EXPIRES_IN="1h"

# Notification outbox worker settings (optional - defaults shown)
NOTIFICATION_OUTBOX_POLL_INTERVAL_MS=5000
NOTIFICATION_OUTBOX_BATCH_SIZE=10
NOTIFICATION_OUTBOX_MAX_RETRIES=3
