{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/main/index.ts server",
    "dev:worker": "cross-env NODE_ENV=development tsx watch src/main/index.ts worker",
    "build": "npx prisma generate && node esbuild.config.js",
    "start": "cross-env NODE_ENV=production node dist/index.js server",
    "start:worker": "cross-env NODE_ENV=production node dist/index.js worker",
    "seed": "cross-env NODE_ENV=production tsx src/main/index.ts seed",
    "seed:dev": "cross-env NODE_ENV=development tsx src/main/index.ts seed:dev",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:unit": "cross-env NODE_ENV=test vitest run",
    "test:integration": "cross-env NODE_ENV=test vitest run --config vitest.integration.config.ts",
    "test:e2e": "cross-env NODE_ENV=test vitest run --config vitest.e2e.config.ts",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.986.0",
    "@aws-sdk/s3-request-presigner": "^3.986.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@repo/dtos": "*",
    "argon2": "^0.44.0",
    "bcrypt": "^6.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.3.3",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.17.2",
    "pg-boss": "^12.18.2",
    "pino": "^10.3.1",
    "resend": "^6.9.1",
    "uuidv7": "^1.1.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.7",
    "@types/pg": "^8.16.0",
    "esbuild": "^0.27.3",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.3.0",
    "testcontainers": "^11.7.2",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
