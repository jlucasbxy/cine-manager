// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client"
  output          = "./generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

model User {
  id                  String               @id @db.Uuid
  name                String
  email               String               @unique
  password            String
  avatarUrl           String?
  createdAt           DateTime
  updatedAt           DateTime
  movies              Movie[]
  ratings             Rating[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  movieLists          MovieList[]
}

model RefreshToken {
  id        String    @id @db.Uuid
  token     String    @unique
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @db.Timestamptz
  revokedAt DateTime? @db.Timestamptz
  createdAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @db.Uuid
  token     String    @unique
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @db.Timestamptz
  usedAt    DateTime? @db.Timestamptz
  createdAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model Language {
  id     String  @id @db.Uuid
  code   String  @unique // ISO 639-1 code (e.g., "en", "pt")
  name   String
  movies Movie[]
}

model Genre {
  id     String  @id @db.Uuid
  name   String  @unique
  movies Movie[]
}

enum AgeRating {
  L
  TEN
  TWELVE
  FOURTEEN
  SIXTEEN
  EIGHTEEN
}

enum MovieStatus {
  RELEASED
  POST_PRODUCTION
  IN_PRODUCTION
  PLANNED
  CANCELED
  RUMORED
}

enum OutboxEventType {
  PASSWORD_RESET_EMAIL
  MOVIE_RELEASE_DATE
  WELCOME_EMAIL
  STORAGE_FILE_DELETE
}

enum OutboxEventStatus {
  PENDING
  PROCESSED
  FAILED
}

model OutboxEvent {
  id           String            @id @db.Uuid
  type         OutboxEventType
  payload      Json
  status       OutboxEventStatus
  retryCount   Int
  error        String?
  createdAt    DateTime
  scheduledFor DateTime?         @db.Timestamptz
  processedAt  DateTime?         @db.Timestamptz
  movieId      String?           @db.Uuid
  movie        Movie?            @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([status, scheduledFor])
}

model Movie {
  id            String                @id @db.Uuid
  title         String
  originalTitle String
  tagline       String
  synopsis      String
  genres        Genre[]
  releaseDate   DateTime              @db.Timestamptz
  runtime       Int
  status        MovieStatus
  ageRating     AgeRating
  languageId    String                @db.Uuid
  language      Language              @relation(fields: [languageId], references: [id])
  budget        Float
  revenue       Float
  posterUrl     String
  backdropUrl   String
  trailerUrl    String
  votes         Int
  score         Float
  isPublic      Boolean               @default(true)
  createdAt     DateTime
  updatedAt     DateTime
  userId        String                @db.Uuid
  user          User                  @relation(fields: [userId], references: [id])
  outboxEvents  OutboxEvent[]
  ratings       Rating[]
  lists         MovieList[]  @relation("MovieListMovies")

  @@index([userId])
  @@index([languageId])
  @@index([status])
  @@index([releaseDate])
  @@index([runtime])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "movie_title_trgm_idx")
}

model MovieList {
  id        String   @id @db.Uuid
  name      String
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movies    Movie[]  @relation("MovieListMovies")
  createdAt DateTime
  updatedAt DateTime

  @@index([userId])
}

model Rating {
  id        String   @id @db.Uuid
  userId    String   @db.Uuid
  movieId   String   @db.Uuid
  value     Int
  createdAt DateTime
  updatedAt DateTime

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([movieId])
}
